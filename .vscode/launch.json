  );
}

/* ============================================================
   SETTINGS
   ============================================================ */
function Settings({ data, commit, flash }) {
  const [f, setF] = useState(data.settings);
  const [pc, setPc] = useState({ current: "", next: "", confirm: "" });
  const [danger, setDanger] = useState(false);

  const saveSettings = () => {
    commit((d) => {
      d.settings = { ...d.settings, ...f, vatRate: num(f.vatRate), gracePeriodDays: num(f.gracePeriodDays) };
    }, "Updated settings", "system");
    flash("Settings saved.");
  };

  const changePasscode = () => {
    if (pc.current !== data.settings.passcode) return flash("Current passcode is wrong.");
    if (pc.next.length < 4) return flash("New passcode must be at least 4 characters.");
    if (pc.next !== pc.confirm) return flash("New passcodes don't match.");
    commit((d) => { d.settings.passcode = pc.next; }, "Changed passcode", "system");
    setPc({ current: "", next: "", confirm: "" });
    flash("Passcode changed.");
  };

  const exportAll = () => {
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `backup-${todayISO()}.json`;
    a.click();
    flash("Backup downloaded.");
  };

  const importAll = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const r = new FileReader();
    r.onload = () => {
      try {
        const parsed = JSON.parse(r.result);
        commit((d) => { Object.keys(DEFAULTS).forEach((k) => { if (parsed[k] !== undefined) d[k] = parsed[k]; }); }, "Restored from backup", "system");
        flash("Backup restored.");
      } catch { flash("That file isn't a valid backup."); }
    };
    r.readAsText(file);
  };

  const wipe = () => {
    commit((d) => {
      const keep = d.settings;
      Object.keys(DEFAULTS).forEach((k) => { if (k !== "settings") d[k] = JSON.parse(JSON.stringify(DEFAULTS[k])); });
      d.settings = keep;
    }, "Erased all records", "system");
    setDanger(false);
    flash("All records erased. Settings kept.");
  };

  return (
    <>
      <div className="panel">
        <div className="panel-head"><h3 className="h3">Business details</h3><span className="quiet">These print on every invoice and receipt.</span></div>
        <div className="pad">
          <div className="row2">
            <Field label="Business name"><input className="input" value={f.businessName} onChange={(e) => setF({ ...f, businessName: e.target.value })} /></Field>
            <Field label="Manager name"><input className="input" value={f.ownerName} onChange={(e) => setF({ ...f, ownerName: e.target.value })} /></Field>
          </div>
          <div className="row2">
            <Field label="Phone"><input className="input" value={f.phone} onChange={(e) => setF({ ...f, phone: e.target.value })} /></Field>
            <Field label="Email"><input className="input" value={f.email} onChange={(e) => setF({ ...f, email: e.target.value })} /></Field>
          </div>
          <Field label="Address"><input className="input" value={f.address} onChange={(e) => setF({ ...f, address: e.target.value })} /></Field>
        </div>
      </div>

      <div className="panel">
        <div className="panel-head"><h3 className="h3">Money & documents</h3></div>
        <div className="pad">
          <div className="row2">
            <Field label="Currency">
              <select className="input" value={f.currency} onChange={(e) => setF({ ...f, currency: e.target.value })}>
                {CURRENCIES.map((c) => <option key={c.code} value={c.code}>{c.code} — {c.symbol}</option>)}
              </select>
            </Field>
            <Field label="Days of grace before an invoice reads as overdue">
              <input className="input mono" type="number" value={f.gracePeriodDays} onChange={(e) => setF({ ...f, gracePeriodDays: e.target.value })} />
            </Field>
          </div>
          <div className="row3">
            <Field label="Invoice prefix"><input className="input mono" value={f.invoicePrefix} onChange={(e) => setF({ ...f, invoicePrefix: e.target.value })} /></Field>
            <Field label="Quote prefix"><input className="input mono" value={f.quotePrefix} onChange={(e) => setF({ ...f, quotePrefix: e.target.value })} /></Field>
            <Field label="Receipt prefix"><input className="input mono" value={f.receiptPrefix} onChange={(e) => setF({ ...f, receiptPrefix: e.target.value })} /></Field>
          </div>
          <label className="check">
            <input type="checkbox" checked={f.vatEnabled} onChange={(e) => setF({ ...f, vatEnabled: e.target.checked })} />
            <span>Apply tax to new invoices by default</span>
          </label>
          {f.vatEnabled && (
            <div className="row2">
              <Field label="Tax label"><input className="input" value={f.vatLabel} onChange={(e) => setF({ ...f, vatLabel: e.target.value })} /></Field>
              <Field label="Rate (%)"><input className="input mono" type="number" value={f.vatRate} onChange={(e) => setF({ ...f, vatRate: e.target.value })} /></Field>
            </div>
          )}
          <button className="btn primary" onClick={saveSettings}>Save settings</button>
        </div>
      </div>

      <div className="panel">
        <div className="panel-head"><h3 className="h3">Passcode</h3></div>
        <div className="pad">
          <div className="row3">
            <Field label="Current"><input className="input" type="password" value={pc.current} onChange={(e) => setPc({ ...pc, current: e.target.value })} /></Field>
            <Field label="New"><input className="input" type="password" value={pc.next} onChange={(e) => setPc({ ...pc, next: e.target.value })} /></Field>
            <Field label="Confirm"><input className="input" type="password" value={pc.confirm} onChange={(e) => setPc({ ...pc, confirm: e.target.value })} /></Field>
          </div>
          <button className="btn" onClick={changePasscode}>Change passcode</button>
        </div>
      </div>

      <div className="panel">
        <div className="panel-head"><h3 className="h3">Backup</h3><span className="quiet">Download a copy you can restore from.</span></div>
        <div className="pad btnrow">
          <button className="btn" onClick={exportAll}>Download backup</button>
          <label className="btn ghost file">
            Restore from backup
            <input type="file" accept="application/json" onChange={importAll} />
          </label>
        </div>
      </div>

      <div className="panel danger-panel">
        <div className="panel-head"><h3 className="h3">Erase records</h3></div>
        <div className="pad">
          {!danger ? (
            <button className="btn danger" onClick={() => setDanger(true)}>Erase all records</button>
          ) : (
            <div className="danger-confirm">
              <p>This deletes every property, tenant, lease, invoice, receipt, and expense. Your settings stay. It cannot be undone — download a backup first.</p>
              <div className="btnrow">
                <button className="btn danger" onClick={wipe}>Yes, erase everything</button>
                <button className="btn ghost" onClick={() => setDanger(false)}>Cancel</button>
              </div>
            </div>
          )}
        </div>
      </div>
    </>
  );
}

/* ============================================================
   DOCUMENT VIEWS (invoice / quote / receipt)
   ============================================================ */
function DocumentView({ doc, data, kind }) {
  const { settings, tenants, units, properties, payments } = data;
  const money = useMoney(settings);
  const t = tenants.find((x) => x.id === doc.tenantId);
  const u = units.find((x) => x.id === doc.unitId);
  const p = u && properties.find((x) => x.id === u.propertyId);
  const { sub, vat, total } = invoiceTotals(doc, settings);
  const paid = kind === "invoice" ? paidOn(doc.id, payments) : 0;

  return (
    <div className="doc">
      <div className="doc-head">
        <div>
          <div className="doc-biz">{settings.businessName}</div>
          <div className="quiet small">{settings.address}</div>
          <div className="quiet small mono">{settings.phone} {settings.email && `· ${settings.email}`}</div>
        </div>
        <div className="r">
          <div className="doc-kind">{kind === "invoice" ? "Invoice" : "Quote"}</div>
          <div className="doc-no mono">{doc.number}</div>
        </div>
      </div>

      <div className="doc-meta">
        <div><span className="lbl">Billed to</span><strong>{t?.name || "—"}</strong><div className="quiet small mono">{t?.phone}</div></div>
        <div><span className="lbl">Unit</span><strong className="mono">{u?.number || "—"}</strong><div className="quiet small">{p?.name}</div></div>
        <div><span className="lbl">Issued</span><strong className="mono">{doc.issueDate}</strong></div>
        <div><span className="lbl">{kind === "invoice" ? "Due" : "Valid until"}</span><strong className="mono">{doc.dueDate}</strong></div>
      </div>

      <table className="table doc-table">
        <thead><tr><th>Description</th><th className="r">Qty</th><th className="r">Rate</th><th className="r">Amount</th></tr></thead>
        <tbody>
          {doc.items.map((i, idx) => (
            <tr key={idx}>
              <td>{i.desc}</td>
              <td className="mono r">{i.qty}</td>
              <td className="mono r">{money(i.rate)}</td>
              <td className="mono r">{money(num(i.qty) * num(i.rate))}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div className="doc-totals">
        <div><span>Subtotal</span><span className="mono">{money(sub)}</span></div>
        {doc.vatApplied && <div><span>{settings.vatLabel} {settings.vatRate}%</span><span className="mono">{money(vat)}</span></div>}
        <div className="grand"><span>Total</span><span className="mono">{money(total)}</span></div>
        {kind === "invoice" && (
          <>
            <div><span>Paid</span><span className="mono moss-text">{money(paid)}</span></div>
            <div className="grand"><span>Balance</span><span className="mono">{money(total - paid)}</span></div>
          </>
        )}
      </div>

      {doc.notes && <div className="doc-notes"><span className="lbl">Notes</span>{doc.notes}</div>}
      <div className="btnrow r"><button className="btn ghost" onClick={() => window.print()}>Print</button></div>
    </div>
  );
}

function ReceiptView({ payment, data }) {
  const { settings, tenants, invoices, units } = data;
  const money = useMoney(settings);
  const t = tenants.find((x) => x.id === payment.tenantId);
  const inv = invoices.find((i) => i.id === payment.invoiceId);
  const u = inv && units.find((x) => x.id === inv.unitId);
  return (
    <div className="doc receipt">
      <div className="doc-head">
        <div>
          <div className="doc-biz">{settings.businessName}</div>
          <div className="quiet small mono">{settings.phone}</div>
        </div>
        <div className="r">
          <div className="doc-kind">Receipt</div>
          <div className="doc-no mono">{payment.receiptNumber}</div>
        </div>
      </div>
      <div className="receipt-amount">
        <span className="lbl">Received with thanks</span>
        <div className="big mono">{money(payment.amount)}</div>
      </div>
      <div className="doc-meta">
        <div><span className="lbl">From</span><strong>{t?.name || "—"}</strong></div>
        <div><span className="lbl">Unit</span><strong className="mono">{u?.number || "—"}</strong></div>
        <div><span className="lbl">Date</span><strong className="mono">{payment.date}</strong></div>
        <div><span className="lbl">Method</span><strong>{payment.method}</strong></div>
        <div><span className="lbl">Against invoice</span><strong className="mono">{inv?.number || "—"}</strong></div>
        <div><span className="lbl">Reference</span><strong className="mono">{payment.reference || "—"}</strong></div>
      </div>
      <div className="receipt-sig">
        <div className="sig-line" />
        <span className="quiet small">{settings.ownerName || "Manager"} · {settings.businessName}</span>
      </div>
      <div className="btnrow r"><button className="btn ghost" onClick={() => window.print()}>Print</button></div>
    </div>
  );
}

/* ============================================================
   FORMS
   ============================================================ */
function LineItemForm({ init, settings, people, units, onSave, dateLabels, dateKeys }) {
  const [f, setF] = useState(init);
  const [err, setErr] = useState("");
  const money = useMoney(settings);
  const setItem = (i, k, v) => {
    const items = [...f.items];
    items[i] = { ...items[i], [k]: v };
    setF({ ...f, items });
  };
  const { sub, vat, total } = invoiceTotals(f, settings);

  const submit = () => {
    if (!f.items.some((i) => i.desc.trim() && num(i.rate) > 0))
      return setErr("Add at least one line with a description and a rate.");
    onSave(f);
  };

  return (
    <>
      <div className="row2">
        <Field label="Tenant">
          <select className="input" value={f.tenantId} onChange={(e) => setF({ ...f, tenantId: e.target.value })}>
            {people.map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}
          </select>
        </Field>
        <Field label="Unit">
          <select className="input" value={f.unitId} onChange={(e) => setF({ ...f, unitId: e.target.value })}>
            {units.map((u) => <option key={u.id} value={u.id}>{u.number}</option>)}
          </select>
        </Field>
      </div>
      <div className="row2">
        <Field label={dateLabels[0]}><input className="input mono" type="date" value={f[dateKeys[0]]} onChange={(e) => setF({ ...f, [dateKeys[0]]: e.target.value })} /></Field>
        <Field label={dateLabels[1]}><input className="input mono" type="date" value={f[dateKeys[1]]} onChange={(e) => setF({ ...f, [dateKeys[1]]: e.target.value })} /></Field>
      </div>

      <div className="lbl">Lines</div>
      <div className="items">
        {f.items.map((it, i) => (
          <div key={i} className="item-row">
            <input className="input" placeholder="Description" value={it.desc} onChange={(e) => setItem(i, "desc", e.target.value)} />
            <input className="input mono" type="number" placeholder="Qty" value={it.qty} onChange={(e) => setItem(i, "qty", e.target.value)} />
            <input className="input mono" type="number" placeholder="Rate" value={it.rate} onChange={(e) => setItem(i, "rate", e.target.value)} />
            <div className="item-amt mono">{money(num(it.qty) * num(it.rate))}</div>
            <button className="btn tiny danger" onClick={() => setF({ ...f, items: f.items.filter((_, x) => x !== i) })} disabled={f.items.length === 1}>×</button>
          </div>
        ))}
      </div>
      <button className="btn small ghost" onClick={() => setF({ ...f, items: [...f.items, { desc: "", qty: 1, rate: "" }] })}>Add line</button>

      <label className="check">
        <input type="checkbox" checked={!!f.vatApplied} onChange={(e) => setF({ ...f, vatApplied: e.target.checked })} />
        <span>Apply {settings.vatLabel} at {settings.vatRate}%</span>
      </label>

      <Field label="Notes"><textarea className="input" rows="2" value={f.notes} onChange={(e) => setF({ ...f, notes: e.target.value })} /></Field>

      <div className="form-totals">
        <div><span>Subtotal</span><span className="mono">{money(sub)}</span></div>
        {f.vatApplied && <div><span>{settings.vatLabel}</span><span className="mono">{money(vat)}</span></div>}
        <div className="grand"><span>Total</span><span className="mono">{money(total)}</span></div>
      </div>

      {err && <div className="err">{err}</div>}
      <button className="btn primary block" onClick={submit}>Save</button>
    </>
  );
}

function PaymentForm({ invoice, settings, payments, onSave }) {
  const money = useMoney(settings);
  const { total } = invoiceTotals(invoice, settings);
  const already = paidOn(invoice.id, payments);
  const balance = total - already;
  const [f, setF] = useState({ date: todayISO(), amount: balance.toFixed(2), method: "Mobile money", reference: "" });
  const [err, setErr] = useState("");

  const submit = () => {
    if (num(f.amount) <= 0) return setErr("Enter an amount greater than zero.");
    if (num(f.amount) > balance + 0.005) return setErr(`That's more than the ${money(balance)} outstanding.`);
    onSave(f);
  };

  return (
    <>
      <div className="balance-note">
        <div><span className="lbl">Invoice total</span><span className="mono">{money(total)}</span></div>
        <div><span className="lbl">Already paid</span><span className="mono">{money(already)}</span></div>
        <div className="grand"><span className="lbl">Outstanding</span><span className="mono">{money(balance)}</span></div>
      </div>
      <div className="row2">
        <Field label="Date received"><input className="input mono" type="date" value={f.date} onChange={(e) => setF({ ...f, date: e.target.value })} /></Field>
        <Field label={`Amount (${settings.currency})`}><input className="input mono" type="number" value={f.amount} onChange={(e) => setF({ ...f, amount: e.target.value })} /></Field>
      </div>
      <div className="row2">
        <Field label="Method">
          <select className="input" value={f.method} onChange={(e) => setF({ ...f, method: e.target.value })}>
            {["Mobile money", "Bank transfer", "Cash", "Cheque", "Card"].map((m) => <option key={m}>{m}</option>)}
          </select>
        </Field>
        <Field label="Reference"><input className="input mono" value={f.reference} onChange={(e) => setF({ ...f, reference: e.target.value })} placeholder="Txn ID" /></Field>
      </div>
      {err && <div className="err">{err}</div>}
      <button className="btn primary block" onClick={submit}>Record payment</button>
    </>
  );
}

function FormBody({ fields, init, onSave }) {
  const [f, setF] = useState(init);
  const [err, setErr] = useState("");
  const submit = () => {
    for (const fd of fields) {
      if (fd.required && !String(f[fd.k] ?? "").trim()) return setErr(`${fd.label} is required.`);
    }
    onSave(f);
  };
  return (
    <>
      {fields.map((fd) => (
        <Field key={fd.k} label={fd.label}>
          {fd.type === "select" ? (
            <select className="input" value={f[fd.k] ?? ""} onChange={(e) => setF({ ...f, [fd.k]: e.target.value })}>
              {fd.options.map((o) => <option key={o.v} value={o.v}>{o.l}</option>)}
            </select>
          ) : fd.type === "textarea" ? (
            <textarea className="input" rows="3" value={f[fd.k] ?? ""} onChange={(e) => setF({ ...f, [fd.k]: e.target.value })} />
          ) : (
            <input
              className={"input" + (["number", "date"].includes(fd.type) ? " mono" : "")}
              type={fd.type || "text"}
              placeholder={fd.placeholder || ""}
              value={f[fd.k] ?? ""}
              onChange={(e) => setF({ ...f, [fd.k]: e.target.value })}
            />
          )}
        </Field>
      ))}
      {err && <div className="err">{err}</div>}
      <button className="btn primary block" onClick={submit}>Save</button>
    </>
  );
}

/* ============================================================
   SMALL PIECES
   ============================================================ */
function useMoney(settings) {
  const sym = CURRENCIES.find((c) => c.code === settings.currency)?.symbol || "";
  return (v) =>
    sym + num(v).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const Field = ({ label, children }) => (
  <label className="field"><span className="lbl">{label}</span>{children}</label>
);

const Stat = ({ label, value, sub, tone = "ink" }) => (
  <div className={"stat " + tone}>
    <div className="stat-label">{label}</div>
    <div className="stat-value mono">{value}</div>
    <div className="stat-sub">{sub}</div>
  </div>
);

const Card = ({ title, sub, children }) => (
  <div className="panel">
    <div className="panel-head"><h3 className="h3">{title}</h3><span className="quiet">{sub}</span></div>
    <div className="pad-tight">{children}</div>
  </div>
);

const Empty = ({ title, body, action }) => (
  <div className="empty">
    <div className="empty-mark">◫</div>
    <h3 className="h3">{title}</h3>
    <p className="quiet">{body}</p>
    {action}
  </div>
);

function Modal({ title, children, onClose, wide }) {
  useEffect(() => {
    const esc = (e) => e.key === "Escape" && onClose();
    window.addEventListener("keydown", esc);
    return () => window.removeEventListener("keydown", esc);
  }, [onClose]);
  return (
    <div className="modal-wrap" onMouseDown={(e) => e.target === e.currentTarget && onClose()}>
      <div className={"modal" + (wide ? " wide" : "")}>
        <div className="modal-head">
          <h3 className="h3">{title}</h3>
          <button className="iconbtn" onClick={onClose} aria-label="Close">×</button>
        </div>
        <div className="modal-body">{children}</div>
      </div>
    </div>
  );
}

/* ============================================================
   STYLE
   ============================================================ */
function Style() {
  return (
    <style>{`
@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

:root{
  --ink:#171D24; --ink-2:#212A33; --ink-3:#2E3843;
  --paper:#F0EFEA; --card:#FFFFFF; --line:#E0DED5;
  --text:#1E252B; --muted:#71797F;
  --brass:#B0812A; --brass-soft:#F5E9CC;
  --moss:#3D6B51; --moss-soft:#DFEAE2;
  --rust:#A63E28; --rust-soft:#F6DFD8;
  --blue:#38566E; --blue-soft:#DCE5EC;
  --grey-soft:#E6E5DE;
  --r:4px;
}
*{box-sizing:border-box}
.app,.gate{font-family:'Archivo',system-ui,sans-serif;color:var(--text);-webkit-font-smoothing:antialiased}
.mono{font-family:'IBM Plex Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}
.app{display:flex;min-height:100vh;background:var(--paper)}

/* rail */
.rail{width:238px;flex:0 0 238px;background:var(--ink);color:#C7CDD3;padding:20px 12px;display:flex;flex-direction:column;gap:22px;position:sticky;top:0;height:100vh;overflow-y:auto}
.brand{display:flex;gap:11px;align-items:center;padding:0 6px}
.brand-plate{width:36px;height:36px;flex:0 0 36px;border-radius:2px;background:linear-gradient(150deg,#D9AE4E,#9A6F1F);color:#241A05;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:13px;display:grid;place-items:center;letter-spacing:.5px}
.brand-name{font-weight:700;color:#F2F3F4;font-size:14px;line-height:1.2}
.brand-sub{font-size:11.5px;color:#7D858D}
.navgroup{margin-bottom:14px}
.navgroup-label{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#666E76;padding:0 8px 7px;font-weight:600}
.navitem{display:flex;align-items:center;gap:10px;width:100%;background:none;border:0;color:#B6BCC2;padding:8px 8px;font:inherit;font-size:13.5px;text-align:left;cursor:pointer;border-radius:var(--r);border-left:2px solid transparent}
.navitem:hover{background:var(--ink-2);color:#EDEFF1}
.navitem.active{background:var(--ink-3);color:#fff;border-left-color:var(--brass);font-weight:600}
.navicon{opacity:.55;width:14px;font-size:12px}
.scrim{display:none}

/* main */
.main{flex:1;min-width:0;display:flex;flex-direction:column}
.topbar{display:flex;align-items:center;gap:14px;padding:18px 30px;border-bottom:1px solid var(--line);background:var(--paper);position:sticky;top:0;z-index:5}
.topbar>div:nth-child(1){flex:1}
.topbar .iconbtn+div{flex:1}
.eyebrow{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600}
.page-title{font-size:19px;font-weight:700;margin:1px 0 0;letter-spacing:-.01em}
.content{padding:26px 30px 60px;max-width:1180px;width:100%}

/* type */
.h2{font-size:16px;font-weight:700;margin:0}
.h3{font-size:13.5px;font-weight:700;margin:0;letter-spacing:-.005em}
.sub{margin:3px 0 0;font-size:12.5px;color:var(--muted)}
.quiet{color:var(--muted);font-size:12.5px}
.small{font-size:11.5px}
.strong{font-weight:600}
.r{text-align:right}
.nowrap{white-space:nowrap}
.moss-text{color:var(--moss)} .rust-text{color:var(--rust)}
.lbl{display:block;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:5px}

.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:4px 0 16px;flex-wrap:wrap}

/* stats */
.statrow{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:26px}
.stat{background:var(--card);border:1px solid var(--line);border-top:2px solid var(--ink);border-radius:var(--r);padding:14px 15px}
.stat.moss{border-top-color:var(--moss)} .stat.rust{border-top-color:var(--rust)} .stat.grey{border-top-color:var(--line)}
.stat-label{font-size:10px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted);font-weight:600}
.stat-value{font-size:22px;font-weight:600;margin:7px 0 3px;letter-spacing:-.02em}
.stat-sub{font-size:11.5px;color:var(--muted)}

/* the board */
.legend{display:flex;gap:16px;font-size:11.5px;color:var(--muted);margin-bottom:16px;flex-wrap:wrap}
.legend.pad{padding:12px 16px 4px;margin:0}
.legend span{display:flex;align-items:center;gap:6px}
.pip{width:8px;height:8px;border-radius:1px;display:inline-block}
.pip.moss{background:var(--moss)} .pip.brass{background:var(--brass)} .pip.rust{background:var(--rust)} .pip.grey{background:#B9B7AC} .pip.blue{background:var(--blue)}

.board-group{margin-bottom:24px}
.board-title{display:flex;align-items:baseline;gap:10px;margin-bottom:10px;padding-bottom:7px;border-bottom:1px solid var(--line);font-weight:700;font-size:13px}
.board-meta{font-weight:400;font-size:11.5px;color:var(--muted)}
.board{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.door{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:2px;background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:13px 13px 11px 17px;cursor:pointer;text-align:left;font:inherit;transition:transform .12s ease,box-shadow .12s ease}
.door:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(23,29,36,.09)}
.door-edge{position:absolute;left:0;top:0;bottom:0;width:4px;border-radius:var(--r) 0 0 var(--r)}
.door.current .door-edge{background:var(--moss)}
.door.due .door-edge{background:var(--brass)}
.door.overdue .door-edge{background:var(--rust)}
.door.vacant .door-edge{background:#C4C2B7}
.door.vacant{background:repeating-linear-gradient(135deg,#FBFBF9,#FBFBF9 6px,#F4F3EF 6px,#F4F3EF 12px)}
.door-no{font-family:'IBM Plex Mono',monospace;font-size:19px;font-weight:600;letter-spacing:-.02em;color:var(--ink)}
.door-tenant{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.door.vacant .door-tenant{color:var(--muted);font-weight:400}
.door-foot{display:flex;justify-content:space-between;align-items:baseline;width:100%;margin-top:7px;padding-top:7px;border-top:1px dashed var(--line);gap:6px}
.door-rent{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted)}
.door-state{font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:700}
.door.current .door-state{color:var(--moss)} .door.due .door-state{color:var(--brass)}
.door.overdue .door-state{color:var(--rust)} .door.vacant .door-state{color:var(--muted)}
.empty-door{cursor:default;color:var(--muted);font-size:12px;justify-content:center;align-items:center;grid-column:1/-1}

/* panels + tables */
.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--r);margin-bottom:18px;overflow:hidden}
.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 16px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.pad{padding:16px}
.pad-tight{padding:6px 16px 12px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:18px}

.table{width:100%;border-collapse:collapse;font-size:13px}
.table th{text-align:left;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:600;padding:9px 16px;border-bottom:1px solid var(--line);background:#FAFAF8}
.table th.r{text-align:right}
.table td{padding:11px 16px;border-bottom:1px solid #F0EFE9;vertical-align:middle}
.table tbody tr:last-child td{border-bottom:0}
.table tbody tr:hover{background:#FBFBF9}

.list{list-style:none;margin:0;padding:0}
.list li{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #F0EFE9;font-size:13px}
.list li:last-child{border-bottom:0}

.log{list-style:none;margin:0;padding:0}
.log li{display:grid;grid-template-columns:74px 1fr auto;gap:12px;align-items:center;padding:10px 16px;border-bottom:1px solid #F0EFE9;font-size:13px}
.log li:last-child{border-bottom:0}
.log-msg{min-width:0}

/* chips */
.chip{display:inline-block;font-size:10px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;padding:3px 7px;border-radius:2px;white-space:nowrap}
.chip.moss{background:var(--moss-soft);color:#2C4E3B}
.chip.rust{background:var(--rust-soft);color:#7E2E1D}
.chip.brass{background:var(--brass-soft);color:#725218}
.chip.blue{background:var(--blue-soft);color:#2A4155}
.chip.grey{background:var(--grey-soft);color:#5E6167}

/* buttons */
.btn{font:inherit;font-size:12.5px;font-weight:600;padding:8px 14px;border-radius:var(--r);border:1px solid var(--line);background:var(--card);color:var(--text);cursor:pointer;transition:background .12s,border-color .12s}
.btn:hover{background:#F6F5F2;border-color:#CFCCC1}
.btn.primary{background:var(--ink);border-color:var(--ink);color:#fff}
.btn.primary:hover{background:var(--ink-3)}
.btn.ghost{background:transparent}
.btn.danger{color:var(--rust);border-color:var(--rust-soft)}
.btn.danger:hover{background:var(--rust-soft)}
.btn.primary.danger,.btn.danger:not(.tiny):not(.small){}
.btn.small{padding:6px 11px;font-size:11.5px}
.btn.tiny{padding:4px 8px;font-size:11px;margin-left:4px}
.btn.block{width:100%;margin-top:14px;padding:11px}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btnrow{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.btnrow.r{justify-content:flex-end;margin-top:16px}
.iconbtn{background:none;border:0;font-size:19px;line-height:1;color:var(--muted);cursor:pointer;padding:4px 8px;border-radius:var(--r)}
.iconbtn:hover{background:var(--grey-soft)}
.only-mobile{display:none}
.btn.file{position:relative;overflow:hidden}
.btn.file input{position:absolute;inset:0;opacity:0;cursor:pointer}

.tabs{display:flex;gap:2px;margin-bottom:16px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.tab{font:inherit;font-size:12.5px;font-weight:600;background:none;border:0;border-bottom:2px solid transparent;padding:8px 12px;color:var(--muted);cursor:pointer;margin-bottom:-1px}
.tab:hover{color:var(--text)}
.tab.on{color:var(--ink);border-bottom-color:var(--brass)}

/* forms */
.field{display:block;margin-bottom:13px}
.input{width:100%;font:inherit;font-size:13px;padding:8px 10px;border:1px solid var(--line);border-radius:var(--r);background:#FCFCFB;color:var(--text)}
.input:focus{outline:2px solid var(--brass);outline-offset:-1px;border-color:var(--brass);background:#fff}
textarea.input{resize:vertical}
.input.center{text-align:center;letter-spacing:.3em;font-size:16px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.check{display:flex;align-items:center;gap:8px;font-size:12.5px;margin:6px 0 14px;cursor:pointer}
.err{background:var(--rust-soft);color:#7E2E1D;font-size:12.5px;padding:8px 11px;border-radius:var(--r);margin:8px 0;font-weight:500}

.items{display:flex;flex-direction:column;gap:7px;margin-bottom:9px}
.item-row{display:grid;grid-template-columns:1fr 70px 100px 92px 30px;gap:7px;align-items:center}
.item-amt{font-size:12.5px;text-align:right;color:var(--muted)}

.form-totals,.doc-totals,.balance-note{margin-top:16px;border-top:1px solid var(--line);padding-top:11px;font-size:13px}
.form-totals div,.doc-totals div,.balance-note div{display:flex;justify-content:space-between;padding:4px 0}
.form-totals .grand,.doc-totals .grand,.balance-note .grand{border-top:1px solid var(--line);margin-top:5px;padding-top:8px;font-weight:700;font-size:15px}
.balance-note{margin-top:0;border-top:0;border-bottom:1px solid var(--line);padding-bottom:11px;margin-bottom:15px}
.balance-note .lbl{margin:0}

/* modal */
.modal-wrap{position:fixed;inset:0;background:rgba(23,29,36,.42);display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto;z-index:50}
.modal{background:var(--card);border-radius:var(--r);width:100%;max-width:470px;box-shadow:0 22px 60px rgba(23,29,36,.28);animation:rise .16s ease}
.modal.wide{max-width:680px}
@keyframes rise{from{transform:translateY(10px);opacity:0}to{transform:none;opacity:1}}
.modal-head{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line)}
.modal-body{padding:18px}

/* documents */
.doc-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding-bottom:16px;border-bottom:2px solid var(--ink);margin-bottom:16px}
.doc-biz{font-size:16px;font-weight:800;letter-spacing:-.01em}
.doc-kind{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:700}
.doc-no{font-size:17px;font-weight:600;color:var(--brass)}
.doc-meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:14px;margin-bottom:18px;font-size:13px}
.doc-table{border:1px solid var(--line);border-radius:var(--r)}
.doc-notes{margin-top:16px;background:#FAFAF8;border-left:2px solid var(--brass);padding:10px 12px;font-size:12.5px}
.receipt-amount{background:var(--moss-soft);border-radius:var(--r);padding:16px;text-align:center;margin-bottom:18px}
.receipt-amount .big{font-size:30px;font-weight:600;color:#2C4E3B;letter-spacing:-.02em}
.receipt-sig{margin-top:26px;text-align:right}
.sig-line{border-bottom:1px solid var(--ink);width:190px;margin:0 0 5px auto}

/* chart */
.chart{display:flex;gap:14px;align-items:flex-end;height:180px;padding:20px 16px 0}
.chart-col{flex:1;display:flex;flex-direction:column;align-items:center;height:100%}
.bars{display:flex;gap:3px;align-items:flex-end;height:100%;width:100%;justify-content:center}
.bar{width:14px;min-height:2px;border-radius:1px 1px 0 0}
.bar.billed{background:var(--blue)} .bar.collected{background:var(--moss)} .bar.spent{background:var(--rust)}
.chart-label{font-size:10.5px;color:var(--muted);padding-top:8px;font-weight:600}
.meter{height:6px;background:var(--grey-soft);border-radius:3px;overflow:hidden;min-width:80px}
.meter div{height:100%;background:var(--brass)}

/* empty */
.empty{text-align:center;padding:52px 20px;background:var(--card);border:1px dashed var(--line);border-radius:var(--r);margin-bottom:18px}
.empty-mark{font-size:26px;color:#C9C7BC;margin-bottom:10px}
.empty .quiet{margin:5px 0 16px}
.danger-panel{border-color:var(--rust-soft)}
.danger-confirm p{font-size:12.5px;color:var(--muted);margin:0 0 12px;max-width:520px}

/* gate */
.gate{min-height:100vh;display:grid;place-items:center;background:var(--ink);padding:20px}
.gate-card{background:var(--card);border-radius:6px;padding:32px;width:100%;max-width:360px;text-align:center;box-shadow:0 24px 70px rgba(0,0,0,.35)}
.gate-card.wide{max-width:460px;text-align:left}
.gate-plate{width:44px;height:44px;border-radius:2px;background:linear-gradient(150deg,#D9AE4E,#9A6F1F);color:#241A05;font-family:'IBM Plex Mono',monospace;font-weight:600;display:grid;place-items:center;margin:0 0 16px;letter-spacing:.5px}
.gate-card:not(.wide) .gate-plate{margin:0 auto 16px}
.gate-title{font-size:18px;font-weight:700;margin:0}
.gate-sub{font-size:12.5px;color:var(--muted);margin:5px 0 20px}
.loading{color:var(--muted);font-size:13px}

/* toast */
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;font-size:12.5px;font-weight:500;padding:10px 18px;border-radius:var(--r);box-shadow:0 10px 30px rgba(0,0,0,.25);z-index:80;animation:rise .18s ease}

@media (max-width:900px){
  .split,.row2,.row3{grid-template-columns:1fr}
  .item-row{grid-template-columns:1fr 56px 80px 70px 28px;gap:5px}
  .rail{position:fixed;left:0;top:0;bottom:0;transform:translateX(-100%);transition:transform .2s ease;z-index:60}
  .rail.open{transform:none}
  .scrim{display:block;position:fixed;inset:0;background:rgba(23,29,36,.42);z-index:55}
  .only-mobile{display:block}
  .content,.topbar{padding-left:16px;padding-right:16px}
  .table{font-size:12px}
  .table th,.table td{padding:8px 10px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media print{
  .rail,.topbar,.modal-head,.btnrow,.btn{display:none!important}
  .modal-wrap{position:static;background:none;padding:0}
  .modal{box-shadow:none;max-width:100%}
  .app{background:#fff}
}
`}</style>
  );
}
